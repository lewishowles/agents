{
  "outputStyle": "concise",
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "HCOM": "hcom",
    "MAX_THINKING_TOKENS": "10000"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "permissions": {
    "additionalDirectories": [
      "~/.Trash",
      "~/Dev/Configuration/Agents"
    ],
    "allow": [
      "mcp__codebase-memory-mcp__*",
      "Bash(hcom:*)",
      "PowerShell(hcom:*)",
      "Bash(export HCOM_*=*)",
      "PowerShell($env:HCOM_* = *)",
      "Bash(progress chunk get:*)",
      "Bash(progress chunk list:*)",
      "Bash(python3 .agent/scripts/project-diagnostics.py:*)",
      "Bash(.agent/scripts/project-diagnostics.py:*)",
      "Bash(zsh -n:*)"
    ]
  },
  "skillOverrides": {
    "accessibility": "name-only",
    "bash": "name-only",
    "project-continue": "name-only",
    "claude-api": "name-only",
    "code-style": "on",
    "dependencies": "name-only",
    "test-e2e": "name-only",
    "error-handling": "on",
    "fewer-permission-prompts": "name-only",
    "init": "name-only",
    "keybindings-help": "name-only",
    "loop": "name-only",
    "project-plan-task": "name-only",
    "writing-readme": "name-only",
    "review": "name-only",
    "schedule": "name-only",
    "security-review": "name-only",
    "project-setup": "name-only",
    "simplify": "name-only",
    "swift": "name-only",
    "swift-ui": "name-only",
    "typescript": "name-only",
    "writing-copy": "name-only",
    "test-unit": "name-only",
    "update-config": "name-only",
    "vue-vite": "name-only",
    "vue": "name-only",
    "vue-project-stack": "name-only",
    "writing": "on"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read fp; if echo \"$fp\" | grep -q '\\.env'; then exit 2; fi; }"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/serena-remind.sh\"'"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tool-call-checkpoint.sh\" claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/guard-commit-message.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/guard-destructive.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/guard-hcom-ack.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/guard-no-pager.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/guard-runaway-process.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/guard-search-boundaries.sh\"'"
          }
        ]
      },
      {
        "matcher": "Bash|Task|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd pre || exit 0"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/image-for-agent-read.sh\"'"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/skill-file-trigger.sh\"'"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/test-skeleton-reminder.sh\"'"
          }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks auto-approve --client=claude-code"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd notify || exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd permission-request || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd post || exit 0",
            "timeout": 86400
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/auto-format.sh\"'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/plan-verify.sh\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd post-failure || exit 0"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/tool-failure-log.sh\"'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tool-call-checkpoint.sh\" claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd sessionend || exit 0"
          },
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=claude-code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd sessionstart || exit 0"
          },
          {
            "type": "command",
            "command": "serena-hooks activate --client=claude-code"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/tool-call-checkpoint.sh\" claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd poll || exit 0",
            "timeout": 86400
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd stop-failure || exit 0"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd subagent-start || exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd subagent-stop || exit 0",
            "timeout": 86400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd=${HCOM:-hcom}; command -v \"${cmd%% *}\" >/dev/null 2>&1 && exec $cmd userpromptsubmit || exit 0"
          },
          {
            "type": "command",
            "command": "bash -c 'bash \"$HOME/.claude/hooks/progress-resume.sh\"'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disabledMcpjsonServers": [
    "mdn"
  ],
  "enabledPlugins": {},
  "agentPushNotifEnabled": true,
  "contextCompactionThreshold": 80,
  "modelCaching": true,
  "promptCaching": true
}
