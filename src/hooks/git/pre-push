#!/usr/bin/env bash
# Pre-push hook: runs quick validation, skipping the setup and doctor end-to-end tests.
# Installed via: scripts/setup.sh --claude|--both

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_DIR=$(cd "$SCRIPT_DIR/../../.." && pwd)

printf 'Running validate.sh --quick before push…\n'
bash "$REPO_DIR/scripts/validate.sh" --quick 2>&1 | tail -30
