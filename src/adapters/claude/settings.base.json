{
	"outputStyle": "concise",
	"env": {
		"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
		"CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
		"HCOM": "hcom",
		"MAX_THINKING_TOKENS": "10000"
	},
	"statusLine": {
		"type": "command",
		"command": "bash \"$HOME/.claude/statusline.sh\""
	},
	"permissions": {
		"additionalDirectories": ["~/.Trash", "~/Dev/Configuration/Agents"],
		"allow": [
			"mcp__codebase-memory-mcp__*",
			"Bash(hcom:*)",
			"PowerShell(hcom:*)",
			"Bash(export HCOM_*=*)",
			"PowerShell($env:HCOM_* = *)",
			"Bash(progress chunk get:*)",
			"Bash(progress chunk list:*)",
			"Bash(zsh -n:*)"
		]
	},
	"skillOverrides": {
		"accessibility": "name-only",
		"bash": "name-only",
		"project-continue": "name-only",
		"claude-api": "name-only",
		"code-style": "on",
		"dependencies": "name-only",
		"test-e2e": "name-only",
		"error-handling": "on",
		"fewer-permission-prompts": "name-only",
		"init": "name-only",
		"keybindings-help": "name-only",
		"loop": "name-only",
		"project-plan-task": "name-only",
		"writing-readme": "name-only",
		"review": "name-only",
		"schedule": "name-only",
		"security-review": "name-only",
		"project-setup": "name-only",
		"simplify": "name-only",
		"swift": "name-only",
		"swift-ui": "name-only",
		"typescript": "name-only",
		"writing-copy": "name-only",
		"test-unit": "name-only",
		"update-config": "name-only",
		"vue-vite": "name-only",
		"vue": "name-only",
		"vue-project-stack": "name-only",
		"writing": "on"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "jq -r '.tool_input.file_path // empty' | { read fp; if echo \"$fp\" | grep -q '\\.env'; then exit 2; fi; }"
					}
				]
			}
		]
	},
	"disabledMcpjsonServers": ["mdn"],
	"enabledPlugins": {},
	"agentPushNotifEnabled": true,
	"contextCompactionThreshold": 80,
	"modelCaching": true,
	"promptCaching": true
}
